{
  "name": "bira-tactics-prompt",
  "version": "1.0.0",
  "private": true,
  "description": "B.I.R.A. Tactics Prompt - Battle Intelligence Response Arena",
  "type": "commonjs",
  "scripts": {
    "serve": "npx serve .",
    "test": "npm run test:logic && npm run test:visual",
    "test:logic": "node --test bira-phase1.test.cjs",
    "test:visual": "jest bira-phase1.test.cjs --testEnvironment=jsdom"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.2.0",
    "serve": "^14.2.5"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/bira-phase1.test.cjs"
    ]
  }
}
